apiVersion: v1
kind: ServiceAccount
metadata:
  namespace: kaas-demo
  labels:
    kaas.example.com/r3-probe: auth
  name: kaas-r3-auth-probe
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
immutable: true
metadata:
  namespace: kaas-demo
  labels:
    kaas.example.com/r3-probe: auth
  name: kaas-r3-auth-probe-disabled
data:
  AuthMetadataProbe.java: "// Metadata-only AUTH candidate. Compilation does not authorize\
    \ execution.\nimport java.io.DataInputStream;\nimport java.io.DataOutputStream;\n\
    import java.io.InputStream;\nimport java.net.InetSocketAddress;\nimport java.net.Socket;\n\
    import java.net.SocketTimeoutException;\nimport java.nio.ByteBuffer;\nimport java.nio.charset.StandardCharsets;\n\
    import java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.KeyStore;\n\
    import java.security.cert.CertificateFactory;\nimport java.util.Arrays;\nimport\
    \ java.util.List;\nimport javax.net.ssl.SSLContext;\nimport javax.net.ssl.SSLException;\n\
    import javax.net.ssl.SSLParameters;\nimport javax.net.ssl.SSLSocket;\nimport javax.net.ssl.TrustManagerFactory;\n\
    import javax.security.auth.callback.NameCallback;\nimport javax.security.auth.callback.PasswordCallback;\n\
    import javax.security.auth.callback.UnsupportedCallbackException;\nimport javax.security.sasl.SaslException;\n\
    import org.apache.kafka.common.message.MetadataRequestData;\nimport org.apache.kafka.common.message.SaslAuthenticateRequestData;\n\
    import org.apache.kafka.common.message.SaslHandshakeRequestData;\nimport org.apache.kafka.common.protocol.Errors;\n\
    import org.apache.kafka.common.requests.AbstractRequest;\nimport org.apache.kafka.common.requests.AbstractResponse;\n\
    import org.apache.kafka.common.requests.MetadataRequest;\nimport org.apache.kafka.common.requests.MetadataResponse;\n\
    import org.apache.kafka.common.requests.RequestHeader;\nimport org.apache.kafka.common.requests.SaslAuthenticateRequest;\n\
    import org.apache.kafka.common.requests.SaslAuthenticateResponse;\nimport org.apache.kafka.common.requests.SaslHandshakeRequest;\n\
    import org.apache.kafka.common.requests.SaslHandshakeResponse;\nimport org.apache.kafka.common.security.scram.internals.ScramMechanism;\n\
    import org.apache.kafka.common.security.scram.internals.ScramMessages.ServerFirstMessage;\n\
    import org.apache.kafka.common.security.scram.internals.ScramSaslClient;\nimport\
    \ org.apache.kafka.common.utils.AppInfoParser;\n\nclass AuthMetadataProbe {\n\
    \  static final String HOST = \"kaas-dev-kafka-bootstrap.kaas-kafka.svc\";\n \
    \ static final String PRINCIPAL = \"kaas-sbx-a-producer\";\n  static final String\
    \ TOPIC = \"kaas-sbx-a-events\";\n  static final String MECHANISM = \"SCRAM-SHA-512\"\
    ;\n  static final Path CA = Path.of(\"/credentials/cluster-ca/ca.crt\");\n  static\
    \ final int MAX_FRAME = 1048576;\n\n  static final class InvalidProtocol extends\
    \ Exception {\n    private static final long serialVersionUID = 1L;\n  }\n  static\
    \ String quote(String s) {\n    return \"\\\"\" + s.replace(\"\\\\\", \"\\\\\\\
    \\\").replace(\"\\\"\", \"\\\\\\\"\") + \"\\\"\";\n  }\n  static SSLContext trustContext()\
    \ throws Exception { return trustContext(CA); }\n  static SSLContext trustContext(Path\
    \ ca) throws Exception {\n    KeyStore trust = KeyStore.getInstance(KeyStore.getDefaultType());\n\
    \    trust.load(null, null);\n    int count = 0;\n    try (InputStream input =\
    \ Files.newInputStream(ca)) {\n      for (java.security.cert.Certificate certificate\
    \ : CertificateFactory.getInstance(\"X.509\").generateCertificates(input))\n \
    \       trust.setCertificateEntry(\"ca-\" + count++, certificate);\n    }\n  \
    \  if (count == 0) throw new InvalidProtocol();\n    TrustManagerFactory managers\
    \ = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());\n\
    \    managers.init(trust);\n    SSLContext context = SSLContext.getInstance(\"\
    TLS\");\n    context.init(null, managers.getTrustManagers(), null);\n    return\
    \ context;\n  }\n  static final class Wire {\n    final DataInputStream input;\n\
    \    final DataOutputStream output;\n    int correlation = 0;\n    Wire(SSLSocket\
    \ socket) throws Exception {\n      input = new DataInputStream(socket.getInputStream());\n\
    \      output = new DataOutputStream(socket.getOutputStream());\n    }\n    AbstractResponse\
    \ exchange(AbstractRequest request) throws Exception {\n      if (++correlation\
    \ > 4) throw new InvalidProtocol();\n      RequestHeader header = new RequestHeader(request.apiKey(),\
    \ request.version(), \"kaas-r3-auth-metadata\", correlation);\n      ByteBuffer\
    \ encoded = request.serializeWithHeader(header);\n      if (encoded.remaining()\
    \ <= 0 || encoded.remaining() > MAX_FRAME) throw new InvalidProtocol();\n    \
    \  byte[] body = new byte[encoded.remaining()];\n      encoded.get(body);\n  \
    \    try {\n        output.writeInt(body.length);\n        output.write(body);\n\
    \        output.flush();\n      } finally { Arrays.fill(body, (byte) 0); }\n \
    \     int size = input.readInt();\n      if (size < 4 || size > MAX_FRAME) throw\
    \ new InvalidProtocol();\n      byte[] response = input.readNBytes(size);\n  \
    \    if (response.length != size) throw new InvalidProtocol();\n      try {\n\
    \        ByteBuffer buffer = ByteBuffer.wrap(response);\n        // Pinned SDK\
    \ verifies response correlation against this exact request.\n        AbstractResponse\
    \ parsed = AbstractResponse.parseResponse(buffer, header);\n        if (buffer.hasRemaining())\
    \ throw new InvalidProtocol();\n        return parsed;\n      } finally { Arrays.fill(response,\
    \ (byte) 0); }\n    }\n    SaslAuthenticateResponse authenticate(byte[] token)\
    \ throws Exception {\n      if (token == null || token.length > 16384) throw new\
    \ InvalidProtocol();\n      try {\n        return (SaslAuthenticateResponse) exchange(new\
    \ SaslAuthenticateRequest(\n            new SaslAuthenticateRequestData().setAuthBytes(token),\
    \ (short) 1));\n      } finally { Arrays.fill(token, (byte) 0); }\n    }\n  }\n\
    \  static String observe(char[] password) throws Exception {\n    SSLContext context\
    \ = trustContext();\n    try (Socket raw = new Socket()) {\n      raw.connect(new\
    \ InetSocketAddress(HOST, 9093), 5000);\n      try (SSLSocket socket = (SSLSocket)\
    \ context.getSocketFactory().createSocket(raw, HOST, 9093, true)) {\n        return\
    \ observeSocket(socket, password);\n      }\n    }\n  }\n  // Package-private\
    \ transport boundary permits loopback fixtures without making\n  // the deployed\
    \ main endpoint, trust path or profile configurable.\n  static String observeSocket(SSLSocket\
    \ socket, char[] password) throws Exception {\n    ScramSaslClient scram = new\
    \ ScramSaslClient(ScramMechanism.SCRAM_SHA_512, callbacks -> {\n      for (javax.security.auth.callback.Callback\
    \ callback : callbacks) {\n        if (callback instanceof NameCallback) ((NameCallback)\
    \ callback).setName(PRINCIPAL);\n        else if (callback instanceof PasswordCallback)\
    \ ((PasswordCallback) callback).setPassword(password);\n        else throw new\
    \ UnsupportedCallbackException(callback);\n      }\n    });\n    try {\n     \
    \   socket.setSoTimeout(5000);\n        SSLParameters parameters = socket.getSSLParameters();\n\
    \        parameters.setEndpointIdentificationAlgorithm(\"HTTPS\");\n        socket.setSSLParameters(parameters);\n\
    \        socket.startHandshake();\n        Wire wire = new Wire(socket);\n   \
    \     SaslHandshakeResponse handshake = (SaslHandshakeResponse) wire.exchange(new\
    \ SaslHandshakeRequest(\n            new SaslHandshakeRequestData().setMechanism(MECHANISM),\
    \ (short) 1));\n        if (handshake.error() != Errors.NONE || !handshake.enabledMechanisms().contains(MECHANISM))\n\
    \          return \"OTHER_AUTHENTICATION_FAILURE\";\n        SaslAuthenticateResponse\
    \ first = wire.authenticate(scram.evaluateChallenge(new byte[0]));\n        if\
    \ (first.error() != Errors.NONE) return \"LOCAL_OR_UNPROVEN_SASL_FAILURE\";\n\
    \        byte[] challenge = first.saslAuthBytes();\n        if (challenge == null\
    \ || challenge.length == 0 || challenge.length > 16384) throw new InvalidProtocol();\n\
    \        int iterations = new ServerFirstMessage(challenge).iterations();\n  \
    \      // Bound broker-controlled proof work before evaluating the challenge.\n\
    \        if (iterations < 4096 || iterations > 65536) throw new InvalidProtocol();\n\
    \        byte[] proof = scram.evaluateChallenge(challenge);\n        SaslAuthenticateResponse\
    \ last = wire.authenticate(proof);\n        // Only a parsed, correlated response\
    \ on verified TLS after client-final\n        // may establish broker rejection.\
    \ Never inspect error text or stacks.\n        if (last.error() == Errors.SASL_AUTHENTICATION_FAILED)\
    \ return \"BROKER_SASL_REJECTED\";\n        if (last.error() != Errors.NONE) return\
    \ \"OTHER_AUTHENTICATION_FAILURE\";\n        byte[] serverFinal = last.saslAuthBytes();\n\
    \        if (serverFinal == null || serverFinal.length == 0 || serverFinal.length\
    \ > 16384) throw new InvalidProtocol();\n        scram.evaluateChallenge(serverFinal);\
    \ // Verify server signature for positives.\n        if (!scram.isComplete())\
    \ throw new InvalidProtocol();\n        MetadataResponse metadata = (MetadataResponse)\
    \ wire.exchange(new MetadataRequest(\n            new MetadataRequestData().setTopics(MetadataRequest.convertToMetadataRequestTopic(List.of(TOPIC)))\n\
    \                .setAllowAutoTopicCreation(false), (short) 4));\n        if (metadata.data().topics().size()\
    \ != 1) return \"METADATA_MISMATCH\";\n        var topic = metadata.data().topics().iterator().next();\n\
    \        if (topic.errorCode() == Errors.TOPIC_AUTHORIZATION_FAILED.code()) return\
    \ \"AUTHORIZATION_FAILURE\";\n        if (!TOPIC.equals(topic.name()) || topic.errorCode()\
    \ != 0 || topic.partitions().isEmpty())\n          return \"METADATA_MISMATCH\"\
    ;\n        for (var partition : topic.partitions())\n          if (partition.errorCode()\
    \ != 0 || partition.leaderId() < 0) return \"METADATA_MISMATCH\";\n        return\
    \ \"OWN_METADATA_OK\";\n    } finally { scram.dispose(); }\n  }\n  static String\
    \ safeOutcome(Throwable error) {\n    if (error instanceof IllegalArgumentException)\
    \ return \"INPUT_INVALID\";\n    if (error instanceof SSLException) return \"\
    TLS_FAILURE\";\n    if (error instanceof SocketTimeoutException) return \"TIMEOUT\"\
    ;\n    if (error instanceof SaslException) return \"LOCAL_OR_UNPROVEN_SASL_FAILURE\"\
    ;\n    return \"UNCLASSIFIED_FAILURE\";\n  }\n  public static void main(String[]\
    \ args) {\n    String phase = \"invalid\", outcome = \"INPUT_INVALID\";\n    int\
    \ code = 21;\n    char[] password = null;\n    try {\n      if (args.length !=\
    \ 2 || !List.of(\"positive_before\", \"negative\", \"positive_after\").contains(args[0]))\n\
    \        throw new IllegalArgumentException();\n      phase = args[0];\n     \
    \ if (!\"4.2.1.redhat-00003\".equals(args[1]) || !args[1].equals(AppInfoParser.getVersion()))\n\
    \        throw new IllegalArgumentException();\n      byte[] supplied;\n     \
    \ try (InputStream input = System.in) { supplied = input.readNBytes(4097); }\n\
    \      try {\n        if (supplied.length == 0 || supplied.length > 4096) throw\
    \ new IllegalArgumentException();\n        for (byte value : supplied) if (value\
    \ == 0 || value == 10 || value == 13) throw new IllegalArgumentException();\n\
    \        password = StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(supplied)).toString().toCharArray();\n\
    \      } finally { Arrays.fill(supplied, (byte) 0); }\n      outcome = observe(password);\n\
    \      code = outcome.equals(\"OWN_METADATA_OK\") ? 0 : (outcome.equals(\"BROKER_SASL_REJECTED\"\
    ) ? 20 : 21);\n    } catch (Throwable error) { outcome = safeOutcome(error);\n\
    \    } finally { if (password != null) Arrays.fill(password, '\\0'); }\n    System.out.println(\"\
    {\\\"schema\\\":\\\"kaas-r3-auth-phase/v1\\\",\\\"phase\\\":\" + quote(phase)\n\
    \        + \",\\\"outcome\\\":\" + quote(outcome) + \"}\");\n    System.exit(code);\n\
    \  }\n}\n"
  run_probe.py: "\"\"\"Disabled candidate supervisor. Network calls exist only in\
    \ the reviewed child protocol probe.\nDo not execute during offline preparation;\
    \ the future profile must be explicitly armed.\n\"\"\"\nimport hashlib\nimport\
    \ hmac\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport secrets\n\
    import selectors\nimport signal\nimport subprocess\nimport time\n\nROOT = Path('/probe')\n\
    PASSWORD = Path('/credentials/principal/password')\nCA = Path('/credentials/cluster-ca/ca.crt')\n\
    EVIDENCE = Path('/evidence')\nACTIVE_PROCESS = None\nPHASES = ('positive_before',\
    \ 'negative', 'positive_after')\nOUTCOMES = {'OWN_METADATA_OK', 'BROKER_SASL_REJECTED',\
    \ 'TLS_FAILURE', 'AUTHORIZATION_FAILURE',\n            'TIMEOUT', 'OTHER_AUTHENTICATION_FAILURE',\
    \ 'LOCAL_OR_UNPROVEN_SASL_FAILURE',\n            'UNCLASSIFIED_FAILURE', 'INPUT_INVALID',\
    \ 'METADATA_MISMATCH', 'CLOSE_FAILED'}\n\nclass Stop(Exception):\n    pass\n\n\
    def strict_json(raw):\n    def pairs(items):\n        result = {}\n        for\
    \ key, value in items:\n            if key in result:\n                raise Stop('DUPLICATE_JSON_KEY')\n\
    \            result[key] = value\n        return result\n    return json.loads(raw,\
    \ object_pairs_hook=pairs, parse_constant=lambda _: (_ for _ in ()).throw(Stop('INVALID_JSON_NUMBER')))\n\
    \ndef file_bytes(path, maximum):\n    with path.open('rb') as stream:\n      \
    \  data = stream.read(maximum + 1)\n    if len(data) > maximum:\n        raise\
    \ Stop('INPUT_SIZE')\n    return data\n\ndef source_lock():\n    lock = strict_json(file_bytes(ROOT\
    \ / 'source-lock.json', 8192))\n    expected = {'AuthMetadataProbe.java', 'run_probe.py',\
    \ 'log4j2.properties'}\n    if set(lock['files']) != expected:\n        raise\
    \ Stop('SOURCE_LOCK_SHAPE')\n    for name, digest in lock['files'].items():\n\
    \        if not re.fullmatch(r'[0-9a-f]{64}', digest) or hashlib.sha256(file_bytes(ROOT\
    \ / name, 65536)).hexdigest() != digest:\n            raise Stop('SOURCE_DRIFT')\n\
    \    return hashlib.sha256(file_bytes(ROOT / 'source-lock.json', 8192)).hexdigest()\n\
    \ndef kill_group(process):\n    # Any timeout/forced termination is nonpassing.\
    \ Killing a wait never proves\n    # SDK cancellation; termination itself must\
    \ be externally observed later.\n    try:\n        os.killpg(process.pid, signal.SIGTERM)\n\
    \    except ProcessLookupError:\n        pass\n    try:\n        process.wait(timeout=1)\n\
    \    except subprocess.TimeoutExpired:\n        pass\n    try:\n        os.killpg(process.pid,\
    \ signal.SIGKILL)\n    except ProcessLookupError:\n        pass\n    try:\n  \
    \      process.wait(timeout=1)\n    except subprocess.TimeoutExpired:\n      \
    \  raise Stop('PROCESS_TERMINATION_UNCONFIRMED')\n\ndef child_phase(phase, supplied_password,\
    \ sdk_version, deadline):\n    global ACTIVE_PROCESS\n    remaining = deadline\
    \ - time.monotonic()\n    if remaining < 3:\n        raise Stop('OVERALL_DEADLINE')\n\
    \    end = time.monotonic() + min(20, remaining - 2)\n    command = ['java', '-Xms32m',\
    \ '-Xmx128m', '-XX:MaxMetaspaceSize=128m',\n               '-XX:ReservedCodeCacheSize=32m',\
    \ '-XX:ActiveProcessorCount=1',\n               '-Djava.io.tmpdir=/tmp', '-Dlog4j2.configurationFile=file:/probe/log4j2.properties',\n\
    \               '-Dlog4j2.statusLoggerLevel=OFF', '--source', '17', '--class-path',\
    \ '/opt/kafka/libs/*',\n               '/probe/AuthMetadataProbe.java', phase,\
    \ sdk_version]\n    # No credentials in argv/environment/config files. Only this\
    \ anonymous stdin\n    # pipe carries the selected password. JVM options from\
    \ the parent are removed.\n    child_env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin'),\
    \ 'HOME': '/tmp', 'LANG': 'C.UTF-8'}\n    if 'JAVA_HOME' in os.environ:\n    \
    \    child_env['JAVA_HOME'] = os.environ['JAVA_HOME']\n    previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK,\
    \ {signal.SIGTERM, signal.SIGINT})\n    try:\n        process = subprocess.Popen(command,\
    \ stdin=subprocess.PIPE, stdout=subprocess.PIPE,\n                           \
    \        stderr=subprocess.PIPE, start_new_session=True, env=child_env)\n    \
    \    ACTIVE_PROCESS = process\n    finally:\n        signal.pthread_sigmask(signal.SIG_SETMASK,\
    \ previous_mask)\n    streams = selectors.DefaultSelector()\n    output = bytearray()\n\
    \    error_count = 0\n    try:\n        process.stdin.write(supplied_password)\n\
    \        process.stdin.close()\n        for stream, tag in [(process.stdout, 'out'),\
    \ (process.stderr, 'err')]:\n            os.set_blocking(stream.fileno(), False)\n\
    \            streams.register(stream, selectors.EVENT_READ, tag)\n        while\
    \ streams.get_map():\n            if time.monotonic() >= end:\n              \
    \  raise Stop('PHASE_DEADLINE')\n            for key, _ in streams.select(timeout=min(.1,\
    \ max(0, end - time.monotonic()))):\n                chunk = os.read(key.fileobj.fileno(),\
    \ 4096)\n                if not chunk:\n                    streams.unregister(key.fileobj)\n\
    \                    continue\n                if key.data == 'out':\n       \
    \             output.extend(chunk)\n                    if len(output) > 8192:\n\
    \                        raise Stop('OUTPUT_LIMIT')\n                else:\n \
    \                   error_count += len(chunk)  # Discard SDK text, never retain\
    \ it.\n                    if error_count > 65536:\n                        raise\
    \ Stop('OUTPUT_LIMIT')\n        code = process.wait(timeout=max(.01, end - time.monotonic()))\n\
    \        event = strict_json(output)\n        if set(event) != {'schema', 'phase',\
    \ 'outcome'} or event['schema'] != 'kaas-r3-auth-phase/v1' or event['phase'] !=\
    \ phase or event['outcome'] not in OUTCOMES:\n            raise Stop('INVALID_PHASE_RESULT')\n\
    \        expected_code = 0 if event['outcome'] == 'OWN_METADATA_OK' else (20 if\
    \ event['outcome'] == 'BROKER_SASL_REJECTED' else 21)\n        if code != expected_code\
    \ or time.monotonic() > deadline:\n            raise Stop('PHASE_EXIT_OR_DEADLINE')\n\
    \        return {'phase': phase, 'outcome': event['outcome'], 'sdk_stderr_bytes_discarded':\
    \ error_count}\n    except Stop:\n        kill_group(process)\n        raise\n\
    \    except Exception:\n        kill_group(process)\n        raise Stop('CHILD_PROCESS_ERROR')\
    \ from None\n    finally:\n        ACTIVE_PROCESS = None\n        streams.close()\n\
    \        for stream in [process.stdout, process.stderr]:\n            stream.close()\n\
    \        output[:] = b''\n\ndef atomic_evidence(name, data):\n    temp = EVIDENCE\
    \ / ('.' + name + '.partial')\n    target = EVIDENCE / name\n    fd = os.open(temp,\
    \ os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    try:\n   \
    \     with os.fdopen(fd, 'wb') as stream:\n            stream.write(data)\n  \
    \          stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(temp,\
    \ target)\n        parent = os.open(EVIDENCE, os.O_RDONLY | os.O_DIRECTORY)\n\
    \        try:\n            os.fsync(parent)\n        finally:\n            os.close(parent)\n\
    \    except Exception:\n        raise Stop('EVIDENCE_WRITE_FAILED') from None\n\
    \ndef termination_evidence(data):\n    # Kubernetes can bind-mount the termination\
    \ file. Renaming over that mount\n    # can fail with EBUSY; write this bounded\
    \ nonsecret summary in place.\n    fd = os.open(EVIDENCE / 'termination.json',\
    \ os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)\n    try:\n        with os.fdopen(fd,\
    \ 'wb') as stream:\n            stream.write(data)\n            stream.flush()\n\
    \            os.fsync(stream.fileno())\n    except Exception:\n        raise Stop('EVIDENCE_WRITE_FAILED')\
    \ from None\n\ndef main():\n    started = time.monotonic()\n    deadline = started\
    \ + 90\n    record = {'schema': 'kaas-r3-auth-result/v1', 'status': 'NOT_RUN',\
    \ 'reason': 'GATE_DISABLED',\n              'events': [], 'application_value_bytes':\
    \ 0, 'producer_consumer_operations': 0,\n              'credential_values_or_hashes_recorded':\
    \ False, 'external_notifications': False}\n    exit_code = 100\n    try:\n   \
    \     raw = file_bytes(ROOT / 'profile.json', 16384)\n        profile = strict_json(raw)\n\
    \        if profile.get('execution_enabled') is not True or profile.get('deployment_enabled')\
    \ is not True:\n            raise Stop('GATE_DISABLED')\n        approval = os.environ.get('R3_AUTH_APPROVED_PROFILE_SHA256',\
    \ '')\n        if not re.fullmatch(r'[0-9a-f]{64}', approval) or hashlib.sha256(raw).hexdigest()\
    \ != approval:\n            raise Stop('PROFILE_APPROVAL_MISMATCH')\n        if\
    \ profile['case'] != 'R3-02-AUTH' or profile['external_notifications_enabled']\
    \ is not False or profile['protected_Jobs_must_remain_suspended'] is not True:\n\
    \            raise Stop('SCOPE_MISMATCH')\n        contract = {'classifier': 'TLS_CORRELATED_SASL_AUTHENTICATE_V1_ERROR_58_AFTER_CLIENT_FINAL',\n\
    \                    'SaslHandshake_version': 1, 'SaslAuthenticate_version': 1,\
    \ 'Metadata_version': 4,\n                    'allow_auto_topic_creation': False,\
    \ 'SDK': '4.2.1.redhat-00003'}\n        if profile.get('protocol_contract') !=\
    \ contract:\n            raise Stop('PROTOCOL_CONTRACT_MISMATCH')\n        fixed\
    \ = {'bootstrap': 'kaas-dev-kafka-bootstrap.kaas-kafka.svc:9093', 'principal':\
    \ 'kaas-sbx-a-producer',\n                 'topic': 'kaas-sbx-a-events', 'TLS':\
    \ 'REQUIRED_CA_AND_HOSTNAME_VERIFICATION',\n                 'SASL': 'SCRAM-SHA-512',\
    \ 'credential_file': '/credentials/principal/password',\n                 'cluster_CA_file':\
    \ '/credentials/cluster-ca/ca.crt'}\n        if profile['fixed_scope'] != fixed:\n\
    \            raise Stop('SCOPE_MISMATCH')\n        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}',\
    \ profile['run_id'] or '') or not isinstance(profile['authorization_reference'],\
    \ str) or not profile['authorization_reference']:\n            raise Stop('AUTHORIZATION_MISSING')\n\
    \        now = time.time()\n        if not (type(profile['window_start_epoch'])\
    \ is int and type(profile['window_end_epoch']) is int and\n                profile['window_start_epoch']\
    \ <= now < profile['window_end_epoch'] and 0 < profile['window_end_epoch'] - profile['window_start_epoch']\
    \ <= 600):\n            raise Stop('WINDOW_MISMATCH')\n        deadline = min(deadline,\
    \ started + profile['window_end_epoch'] - now)\n        version = profile['expected_sdk_version']\n\
    \        jar = profile['expected_sdk_jar']\n        if not isinstance(version,\
    \ str) or version != '4.2.1.redhat-00003':\n            raise Stop('SDK_IDENTITY_MISSING')\n\
    \        if not isinstance(jar, str) or jar != 'kafka-clients-4.2.1.redhat-00003.jar':\n\
    \            raise Stop('SDK_IDENTITY_MISSING')\n        digest = profile['expected_sdk_jar_sha256']\n\
    \        if not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest):\n\
    \            raise Stop('SDK_IDENTITY_MISSING')\n        jar_files = list(Path('/opt/kafka/libs').glob('kafka-clients-*.jar'))\n\
    \        if len(jar_files) != 1 or jar_files[0].name != jar:\n            raise\
    \ Stop('SDK_IDENTITY_MISMATCH')\n        jar_digest = hashlib.sha256()\n     \
    \   with jar_files[0].open('rb') as stream:\n            for chunk in iter(lambda:\
    \ stream.read(1048576), b''):\n                jar_digest.update(chunk)\n    \
    \    if jar_digest.hexdigest() != digest:\n            raise Stop('SDK_IDENTITY_MISMATCH')\n\
    \        if not profile['runtime_image_reference'] or not re.fullmatch(r'.+@sha256:[0-9a-f]{64}',\
    \ profile['runtime_image_reference']):\n            raise Stop('IMAGE_IDENTITY_MISSING')\n\
    \        record['source_lock_sha256'] = source_lock()\n        record['run_id']\
    \ = profile['run_id']\n        record['profile_sha256'] = approval\n        record['runtime_image_reference_configured_not_attested']\
    \ = profile['runtime_image_reference']\n        record['sdk_version_expected']\
    \ = version\n        password = file_bytes(PASSWORD, 4096)\n        if not password\
    \ or any(c in password for c in [b'\\n', b'\\r', b'\\x00']):\n            raise\
    \ Stop('CREDENTIAL_INPUT_INVALID')\n        try:\n            password.decode('utf-8',\
    \ errors='strict')\n        except UnicodeDecodeError:\n            raise Stop('CREDENTIAL_INPUT_INVALID')\
    \ from None\n        # Fixed source facts, no arbitrary client endpoint/principal/topic\
    \ inputs.\n        ca_start = file_bytes(CA, 131072)\n        if b'-----BEGIN\
    \ CERTIFICATE-----' not in ca_start:\n            raise Stop('TRUST_INPUT_INVALID')\n\
    \        bad_password = secrets.token_urlsafe(32).encode('ascii')\n        if\
    \ hmac.compare_digest(password, bad_password):\n            raise Stop('NEGATIVE_INPUT_COLLISION')\n\
    \        for phase in PHASES:\n            if not hmac.compare_digest(file_bytes(PASSWORD,\
    \ 4096), password) or file_bytes(CA, 131072) != ca_start:\n                raise\
    \ Stop('CREDENTIAL_OR_TRUST_CHANGED')\n            event = child_phase(phase,\
    \ bad_password if phase == 'negative' else password, version, deadline)\n    \
    \        record['events'].append(event)\n            wanted = 'BROKER_SASL_REJECTED'\
    \ if phase == 'negative' else 'OWN_METADATA_OK'\n            if event['outcome']\
    \ != wanted:\n                record['status'] = 'FAIL' if phase == 'negative'\
    \ and event['outcome'] in ['OWN_METADATA_OK', 'AUTHORIZATION_FAILURE'] else 'INCONCLUSIVE'\n\
    \                raise Stop('UNEXPECTED_NEGATIVE_SUCCESS_OR_WRONG_LAYER' if phase\
    \ == 'negative' else 'POSITIVE_CONTROL_FAILED')\n        if not hmac.compare_digest(file_bytes(PASSWORD,\
    \ 4096), password) or file_bytes(CA, 131072) != ca_start:\n            raise Stop('CREDENTIAL_OR_TRUST_CHANGED')\n\
    \        if time.monotonic() >= deadline:\n            raise Stop('OVERALL_DEADLINE')\n\
    \        record.update(status='AUTH_PAIR_OBSERVED', reason='CONTROLS_AND_BROKER_SASL_REJECTION')\n\
    \        exit_code = 0\n    except Stop as error:\n        record['reason'] =\
    \ str(error)  # Only local fixed enum strings reach Stop.\n        if record['status']\
    \ == 'NOT_RUN' and (record['events'] or str(error) == 'EXTERNAL_STOP'):\n    \
    \        record['status'] = 'INCONCLUSIVE'\n    except Exception:\n        record.update(status='INCONCLUSIVE',\
    \ reason='LOCAL_PRECONDITION_ERROR')\n    record['elapsed_ms'] = round((time.monotonic()\
    \ - started) * 1000)\n    data = (json.dumps(record, sort_keys=True, separators=(',',\
    \ ':')) + '\\n').encode()\n    if len(data) > 3000:\n        record.update(status='INCONCLUSIVE',\
    \ reason='RESULT_SIZE_LIMIT', events=[])\n        exit_code = 101\n        data\
    \ = (json.dumps(record, sort_keys=True, separators=(',', ':')) + '\\n').encode()\n\
    \    try:\n        atomic_evidence('result.json', data)\n        termination_evidence(data)\n\
    \        if exit_code == 0 and time.monotonic() >= deadline:\n            raise\
    \ Stop('OVERALL_DEADLINE')\n    except Exception:\n        print('{\"schema\"\
    :\"kaas-r3-auth-result/v1\",\"status\":\"INCONCLUSIVE\",\"reason\":\"EVIDENCE_OR_FINAL_DEADLINE_FAILED\"\
    }', flush=True)\n        return 101\n    print(data.decode(), end='', flush=True)\n\
    \    return exit_code\n\ndef external_stop(signum, frame):\n    if ACTIVE_PROCESS\
    \ is not None:\n        try:\n            os.killpg(ACTIVE_PROCESS.pid, signal.SIGKILL)\n\
    \        except ProcessLookupError:\n            pass\n    raise Stop('EXTERNAL_STOP')\n\
    \nif __name__ == '__main__':\n    signal.signal(signal.SIGTERM, external_stop)\n\
    \    signal.signal(signal.SIGINT, external_stop)\n    try:\n        code = main()\n\
    \    except BaseException:\n        print('{\"schema\":\"kaas-r3-auth-result/v1\"\
    ,\"status\":\"INCONCLUSIVE\",\"reason\":\"EXTERNAL_STOP_OR_SUPERVISOR_ERROR\"\
    }', flush=True)\n        code = 101\n    raise SystemExit(code)\n"
  log4j2.properties: 'status = OFF

    rootLogger.level = OFF

    '
  source-lock.json: "{\n  \"schema\": \"kaas-r3-auth-source-lock/v1\",\n  \"files\"\
    : {\n    \"AuthMetadataProbe.java\": \"3ba175ee740fc7d991b29a776a6c416fde360269fb6b31fb4cb73857a224564c\"\
    ,\n    \"run_probe.py\": \"18dd220f1999c2ce6a6f2a3942c5243e3e5041f2b131b982cdaca8ceb5e4a1fe\"\
    ,\n    \"log4j2.properties\": \"a10f28bc03e2804ca55bfe6e7ca17be4d0c7763b822bf37d01a120e77b4bb576\"\
    \n  }\n}\n"
  profile.json: "{\n  \"schema\": \"kaas-r3-auth-profile/v1\",\n  \"case\": \"R3-02-AUTH\"\
    ,\n  \"status\": \"OFFLINE_BEHAVIOR_PASS_DISABLED_LIVE_UNQUALIFIED\",\n  \"source_review_commit\"\
    : \"c9aba5af22612da0e5d2f7ba4d9b825b3df4b26d\",\n  \"execution_enabled\": false,\n\
    \  \"deployment_enabled\": false,\n  \"external_notifications_enabled\": false,\n\
    \  \"protected_Jobs_must_remain_suspended\": true,\n  \"run_id\": null,\n  \"\
    authorization_reference\": null,\n  \"window_start_epoch\": null,\n  \"window_end_epoch\"\
    : null,\n  \"runtime_image_reference\": \"image-registry.openshift-image-registry.svc:5000/kaas-demo/kaas-r2-runner-05a3f2d@sha256:41f328c85ee3d3e9d8834ce12e516b5ef52506067117b1c4f1145511b493998a\"\
    ,\n  \"candidate_existing_image\": \"image-registry.openshift-image-registry.svc:5000/kaas-demo/kaas-r2-runner-05a3f2d@sha256:41f328c85ee3d3e9d8834ce12e516b5ef52506067117b1c4f1145511b493998a\"\
    ,\n  \"expected_sdk_version\": \"4.2.1.redhat-00003\",\n  \"expected_sdk_jar\"\
    : \"kafka-clients-4.2.1.redhat-00003.jar\",\n  \"expected_sdk_jar_sha256\": \"\
    5f13fa84c366c1b20388aadfea9b0539654563bc90bcacd2515c849e8d37e669\",\n  \"fixed_scope\"\
    : {\n    \"bootstrap\": \"kaas-dev-kafka-bootstrap.kaas-kafka.svc:9093\",\n  \
    \  \"principal\": \"kaas-sbx-a-producer\",\n    \"topic\": \"kaas-sbx-a-events\"\
    ,\n    \"TLS\": \"REQUIRED_CA_AND_HOSTNAME_VERIFICATION\",\n    \"SASL\": \"SCRAM-SHA-512\"\
    ,\n    \"credential_file\": \"/credentials/principal/password\",\n    \"cluster_CA_file\"\
    : \"/credentials/cluster-ca/ca.crt\"\n  },\n  \"sequence\": [\n    \"positive_before\"\
    ,\n    \"negative\",\n    \"positive_after\"\n  ],\n  \"proposal_bounds\": {\n\
    \    \"maximum_client_seconds\": 90,\n    \"maximum_phase_seconds\": 20,\n   \
    \ \"Job_activeDeadlineSeconds\": 120,\n    \"maximum_phase_processes\": 3,\n \
    \   \"maximum_metadata_API_calls\": 3,\n    \"maximum_Kafka_RPCs_per_phase\":\
    \ 4,\n    \"maximum_Kafka_RPCs_total\": 12,\n    \"maximum_response_frame_bytes\"\
    : 1048576,\n    \"maximum_SCRAM_iterations\": 65536,\n    \"maximum_negative_processes\"\
    : 1,\n    \"automatic_case_retries\": 0,\n    \"original_application_value_bytes\"\
    : 0,\n    \"maximum_stdout_bytes_per_phase\": 8192,\n    \"maximum_stderr_bytes_discarded_per_phase\"\
    : 65536,\n    \"maximum_sanitized_result_bytes\": 3000\n  },\n  \"bound_note\"\
    : \"These are proposed application/client limits, not approved wire request/byte\
    \ counts or measured timing. SDK protocol negotiation/connection attempts may\
    \ exceed one exchange; no live attempt is authorized.\",\n  \"protocol_contract\"\
    : {\n    \"classifier\": \"TLS_CORRELATED_SASL_AUTHENTICATE_V1_ERROR_58_AFTER_CLIENT_FINAL\"\
    ,\n    \"SaslHandshake_version\": 1,\n    \"SaslAuthenticate_version\": 1,\n \
    \   \"Metadata_version\": 4,\n    \"allow_auto_topic_creation\": false,\n    \"\
    SDK\": \"4.2.1.redhat-00003\"\n  }\n}\n"
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  namespace: kaas-demo
  labels: &id001
    kaas.example.com/r3-probe: auth
  name: kaas-r3-auth-proposed
spec:
  podSelector:
    matchLabels: *id001
  policyTypes:
  - Ingress
  - Egress
  ingress: []
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: openshift-dns
      podSelector:
        matchLabels:
          dns.operator.openshift.io/daemonset-dns: default
    ports:
    - protocol: UDP
      port: 53
    - protocol: UDP
      port: 5353
    - protocol: TCP
      port: 53
    - protocol: TCP
      port: 5353
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kaas-kafka
      podSelector:
        matchLabels:
          strimzi.io/cluster: kaas-dev
          strimzi.io/name: kaas-dev-kafka
    ports:
    - protocol: TCP
      port: 9093
---
apiVersion: batch/v1
kind: Job
metadata:
  namespace: kaas-demo
  labels: &id001
    kaas.example.com/r3-probe: auth
  name: kaas-r3-auth-proposed
spec:
  suspend: true
  backoffLimit: 0
  activeDeadlineSeconds: 120
  parallelism: 1
  completions: 1
  template:
    metadata:
      labels: *id001
    spec:
      serviceAccountName: kaas-r3-auth-probe
      automountServiceAccountToken: false
      hostNetwork: false
      restartPolicy: Never
      terminationGracePeriodSeconds: 3
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: auth-probe
        image: image-registry.openshift-image-registry.svc:5000/kaas-demo/kaas-r2-runner-05a3f2d@sha256:41f328c85ee3d3e9d8834ce12e516b5ef52506067117b1c4f1145511b493998a
        imagePullPolicy: IfNotPresent
        command:
        - timeout
        - --signal=TERM
        - --kill-after=2s
        - 90s
        - python3
        - -I
        - /probe/run_probe.py
        env:
        - name: R3_AUTH_APPROVED_PROFILE_SHA256
          value: ''
        - name: PYTHONDONTWRITEBYTECODE
          value: '1'
        - name: PYTHONUNBUFFERED
          value: '1'
        - name: HOME
          value: /tmp
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: 500m
            memory: 512Mi
        securityContext:
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - name: source
          mountPath: /probe
          readOnly: true
        - name: principal
          mountPath: /credentials/principal
          readOnly: true
        - name: cluster-ca
          mountPath: /credentials/cluster-ca
          readOnly: true
        - name: tmp
          mountPath: /tmp
        - name: evidence
          mountPath: /evidence
        terminationMessagePath: /evidence/termination.json
        terminationMessagePolicy: File
      volumes:
      - name: source
        configMap:
          name: kaas-r3-auth-probe-disabled
          defaultMode: 292
      - name: principal
        secret:
          secretName: kaas-sbx-a-producer
          items:
          - key: password
            path: password
          defaultMode: 288
      - name: cluster-ca
        configMap:
          name: kaas-r2-cluster-ca
          items:
          - key: ca.crt
            path: ca.crt
          defaultMode: 292
      - name: tmp
        emptyDir:
          medium: Memory
          sizeLimit: 64Mi
      - name: evidence
        emptyDir:
          medium: Memory
          sizeLimit: 1Mi
