---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  namespace: kaas-demo
  labels: &id001
    kaas.example.com/r3-probe: auth
  name: kaas-r3-auth-proposed
spec:
  podSelector:
    matchLabels: *id001
  policyTypes:
  - Ingress
  - Egress
  ingress: []
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: openshift-dns
      podSelector:
        matchLabels:
          dns.operator.openshift.io/daemonset-dns: default
    ports:
    - protocol: UDP
      port: 53
    - protocol: UDP
      port: 5353
    - protocol: TCP
      port: 53
    - protocol: TCP
      port: 5353
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kaas-kafka
      podSelector:
        matchLabels:
          strimzi.io/cluster: kaas-dev
          strimzi.io/name: kaas-dev-kafka
    ports:
    - protocol: TCP
      port: 9093
---
apiVersion: batch/v1
kind: Job
metadata:
  namespace: kaas-demo
  labels: &id001
    kaas.example.com/r3-probe: auth
  name: kaas-r3-auth-proposed
spec:
  suspend: true
  backoffLimit: 0
  activeDeadlineSeconds: 120
  parallelism: 1
  completions: 1
  template:
    metadata:
      labels: *id001
    spec:
      serviceAccountName: kaas-r3-auth-probe
      automountServiceAccountToken: false
      hostNetwork: false
      restartPolicy: Never
      terminationGracePeriodSeconds: 3
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: auth-probe
        image: image-registry.openshift-image-registry.svc:5000/kaas-demo/kaas-r2-runner-05a3f2d@sha256:41f328c85ee3d3e9d8834ce12e516b5ef52506067117b1c4f1145511b493998a
        imagePullPolicy: IfNotPresent
        command:
        - timeout
        - --signal=TERM
        - --kill-after=2s
        - 90s
        - python3
        - -I
        - /probe/run_probe.py
        env:
        - name: R3_AUTH_APPROVED_PROFILE_SHA256
          value: ''
        - name: PYTHONDONTWRITEBYTECODE
          value: '1'
        - name: PYTHONUNBUFFERED
          value: '1'
        - name: HOME
          value: /tmp
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: 500m
            memory: 512Mi
        securityContext:
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - name: source
          mountPath: /probe
          readOnly: true
        - name: principal
          mountPath: /credentials/principal
          readOnly: true
        - name: cluster-ca
          mountPath: /credentials/cluster-ca
          readOnly: true
        - name: tmp
          mountPath: /tmp
        - name: evidence
          mountPath: /evidence
        terminationMessagePath: /evidence/termination.json
        terminationMessagePolicy: File
      volumes:
      - name: source
        configMap:
          name: kaas-r3-auth-probe-disabled
          defaultMode: 292
      - name: principal
        secret:
          secretName: kaas-sbx-a-producer
          items:
          - key: password
            path: password
          defaultMode: 288
      - name: cluster-ca
        configMap:
          name: kaas-r2-cluster-ca
          items:
          - key: ca.crt
            path: ca.crt
          defaultMode: 292
      - name: tmp
        emptyDir:
          medium: Memory
          sizeLimit: 64Mi
      - name: evidence
        emptyDir:
          medium: Memory
          sizeLimit: 1Mi
