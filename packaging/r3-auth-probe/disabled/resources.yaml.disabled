  profile.json: "{\n  \"schema\": \"kaas-r3-auth-profile/v1\",\n  \"case\": \"R3-02-AUTH\"\
    ,\n  \"status\": \"PREPARED_DISABLED_NOT_COMPILED_OR_TESTED\",\n  \"source_review_commit\"\
    : \"c9aba5af22612da0e5d2f7ba4d9b825b3df4b26d\",\n  \"execution_enabled\": false,\n\
    \  \"deployment_enabled\": false,\n  \"external_notifications_enabled\": false,\n\
    \  \"protected_Jobs_must_remain_suspended\": true,\n  \"run_id\": null,\n  \"\
    authorization_reference\": null,\n  \"window_start_epoch\": null,\n  \"window_end_epoch\"\
    : null,\n  \"runtime_image_reference\": null,\n  \"candidate_existing_image\"\
    : \"image-registry.openshift-image-registry.svc:5000/kaas-demo/kaas-r2-runner-05a3f2d@sha256:41f328c85ee3d3e9d8834ce12e516b5ef52506067117b1c4f1145511b493998a\"\
    ,\n  \"expected_sdk_version\": null,\n  \"expected_sdk_jar\": null,\n  \"expected_sdk_jar_sha256\"\
    : null,\n  \"fixed_scope\": {\n    \"bootstrap\": \"kaas-dev-kafka-bootstrap.kaas-kafka.svc:9093\"\
    ,\n    \"principal\": \"kaas-sbx-a-producer\",\n    \"topic\": \"kaas-sbx-a-events\"\
    ,\n    \"TLS\": \"REQUIRED_CA_AND_HOSTNAME_VERIFICATION\",\n    \"SASL\": \"SCRAM-SHA-512\"\
    ,\n    \"credential_file\": \"/credentials/principal/password\",\n    \"cluster_CA_file\"\
    : \"/credentials/cluster-ca/ca.crt\"\n  },\n  \"sequence\": [\n    \"positive_before\"\
    ,\n    \"negative\",\n    \"positive_after\"\n  ],\n  \"proposal_bounds\": {\n\
    \    \"maximum_client_seconds\": 90,\n    \"maximum_phase_seconds\": 20,\n   \
    \ \"Job_activeDeadlineSeconds\": 120,\n    \"maximum_phase_processes\": 3,\n \
    \   \"maximum_metadata_API_calls\": 3,\n    \"maximum_negative_processes\": 1,\n\
    \    \"automatic_case_retries\": 0,\n    \"original_application_value_bytes\"\
    : 0,\n    \"maximum_stdout_bytes_per_phase\": 8192,\n    \"maximum_stderr_bytes_discarded_per_phase\"\
    : 65536,\n    \"maximum_sanitized_result_bytes\": 3000\n  },\n  \"bound_note\"\
    : \"These are proposed application/client limits, not approved wire request/byte\
    \ counts or measured timing. SDK protocol negotiation/connection attempts may\
