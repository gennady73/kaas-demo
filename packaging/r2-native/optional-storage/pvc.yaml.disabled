apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: kaas-r2-native-evidence
  namespace: kaas-demo
  labels:
    kaas.example.com/package: r2-native-disabled
  annotations:
    kaas.example.com/status: BOUND_SINK_MOUNT_PERMISSION_VERIFIED
    kaas.example.com/retention: 7days; verified shared-workspace export before approved
      cleanup
spec:
  accessModes:
  - ReadWriteOnce
  storageClassName: gp3-csi
  resources:
    requests:
      storage: 1Gi
