+// DYNAMIC CONFIG STATE
+var (
+	customMaxBytes int
+	loadConfigOnce sync.Once
+)
+
+// getCustomMaxBytes safely reads the limit from disk (or EnvVar) exactly once.
+func getCustomMaxBytes() int {
+	loadConfigOnce.Do(func() {
+		// Base safety default (50MB) if nothing is provided
+		customMaxBytes = 52428800
+
+		// fmt.Printf("*** Value in bytes: %d\n", customMaxBytes)
+
+		// 1. Try reading from the external file mounted via K8s ConfigMap
+		if data, err := os.ReadFile("/script/kafka-client-limits.txt"); err == nil {
+			if parsed, err := strconv.Atoi(strings.TrimSpace(string(data))); err == nil {
+				customMaxBytes = parsed
+				// fmt.Printf("*** Value in bytes Error: %d\n", customMaxBytes)
+				// fmt.Printf("*** Value parsed Error: %d\n", string(data))
+				return
+			}
+		}
+
+		// 2. Fallback to an Environment Variable if the file is missing
+		if envStr := os.Getenv("XK6_KAFKA_MAX_BYTES"); envStr != "" {
+			if parsed, err := strconv.Atoi(envStr); err == nil {
+				customMaxBytes = parsed
+				// fmt.Printf("*** Value in bytes SUCCESS: %d\n", customMaxBytes)
+			}
+		}
+	})
+	return customMaxBytes
+}
