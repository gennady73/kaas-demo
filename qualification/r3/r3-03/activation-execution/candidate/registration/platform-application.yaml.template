apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: kaas-demo-monitoring-platform
  namespace: openshift-gitops
spec:
  project: kaas-demo-monitoring-platform
  source:
    repoURL: https://github.com/gennady73/kaas-demo.git
    targetRevision: ${RESOURCE_COMMIT}
    path: qualification/r3/r3-03/activation-execution/candidate/platform
  destination:
    namespace: openshift-monitoring
    server: https://kubernetes.default.svc
  syncPolicy:
    syncOptions:
    - FailOnSharedResource=true
