apiVersion: kafka.strimzi.io/v1
kind: Kafka
metadata:
  name: kaas-dev
  namespace: kaas-kafka
spec:
  kafkaExporter:
    groupRegex: ^kaas-sbx-[ab]-(events|audit)-group$
    topicRegex: ^kaas-sbx-[ab]-(events|audit)$
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi
