apiVersion: kafka.strimzi.io/v1
kind: Kafka
metadata:
  name: ${cluster_name}
  namespace: ${namespace}
spec:
  kafka:
    version: ${broker_version}
    image: ${image}
    rack:
      topologyKey: ${rack_topology_key}
    listeners:
    - name: tls
      port: 9093
      type: internal
      tls: true
      authentication:
        type: scram-sha-512
      networkPolicyPeers: ${network_peers}
    authorization:
      type: simple
    config:
      default.replication.factor: 2
      min.insync.replicas: ${minimum_isr}
      offsets.topic.replication.factor: 2
      transaction.state.log.replication.factor: 2
      transaction.state.log.min.isr: ${minimum_isr}
      log.retention.ms: 21600000
      auto.create.topics.enable: false
      unclean.leader.election.enable: false
      message.max.bytes: ${record_ceiling_bytes}
      replica.fetch.max.bytes: ${follower_fetch_bytes}
  entityOperator:
    topicOperator:
      resources: ${entity_operator_resources}
    userOperator:
      resources: ${entity_operator_resources}
